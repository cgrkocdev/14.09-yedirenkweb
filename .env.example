# Local admin fallback. Replace this value in your own untracked .env file.
VITE_ADMIN_PASSWORD=change-this-local-password

# HTTPS endpoint for the production donation/payment service.
VITE_PANEL_API_URL=https://api.example.com

# Optional legacy name used when VITE_PANEL_API_URL is not set.
VITE_VEFA_API_URL=

# Server/Worker secrets and bindings are configured in the hosting platform,
# never committed to this file: ADMIN_PASSWORD, ADMIN_SESSION_SECRET,
# USER_SESSION_SECRET, YEDIRENK_CMS, YEDIRENK_ANALYTICS, YEDIRENK_USERS.
# Volunteer/contact submissions additionally require YEDIRENK_APPLICATIONS.
